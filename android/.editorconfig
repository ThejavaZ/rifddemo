root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# El proyecto usa importaciones comodín por estilo; no forzar su expansión.
ktlint_standard_no-wildcard-imports = disabled
# Los @Composable usan PascalCase por convención de Compose.
ktlint_standard_function-naming = disabled
max_line_length = 120
